# Absent DATABASE_URL is a supported state: the fleet falls back to the committed
# seed (src/data/fleet.seed.json). Production must set it.
DATABASE_URL=postgres://forge:password@127.0.0.1:5432/alm_autos

# Public origin, used for canonical, hreflang and sitemap URLs.
SITE_URL=https://alm.autos
VITE_SITE_URL=https://alm.autos

# Enquiry notifications. Without both of these no mail is sent; with no database
# either, the form refuses the submission rather than losing the lead.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=enquiries@alm.autos
ENQUIRY_NOTIFY_EMAIL=

# Uploads live outside releases/ so a deploy cannot delete the client's photos.
UPLOADS_DIR=/home/forge/alm-uploads
