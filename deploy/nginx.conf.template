# Forge nginx template for a TanStack Start (Nitro) site.
#
# Forge's first-class Node support covers Nuxt and Next only; a Nitro app needs
# this by hand. Paste into Forge > Server > Nginx Templates, then pick it when
# creating the site. Template edits do NOT propagate to existing sites.
# See docs/adr/0002.

server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAINS}};
    server_tokens off;
    root {{PATH}}/public;

    # Must stay above the proxy: Let's Encrypt HTTP-01 fails if the catch-all
    # location swallows the challenge.
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root {{PATH}}/public;
    }

    # Hashed build assets and generated photo variants are immutable.
    location ~* ^/(assets|vehicles|fonts)/ {
        expires 1y;
        access_log off;
        add_header Cache-Control "public, immutable";
        try_files $uri @node;
    }

    location / {
        try_files $uri @node;
    }

    location @node {
        proxy_pass http://127.0.0.1:{{PORT}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }

    client_max_body_size 25m;

    access_log off;
    error_log /var/log/nginx/{{SITE}}-error.log error;
}
